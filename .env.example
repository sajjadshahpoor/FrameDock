# Port the server listens on (most hosts set this for you)
PORT=3000

# Set to "production" when deployed: enables HTTPS redirect and asset caching
NODE_ENV=development

# Max people per room. Calls are peer-to-peer mesh, so keep this small.
MAX_PARTICIPANTS=6

# Optional TURN relay for users behind strict firewalls.
# Comma-separate multiple URLs, e.g. turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
